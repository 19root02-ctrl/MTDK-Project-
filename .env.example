# Copy this file to .env and fill values for production SMTP
# Example SMTP settings for real SMTP provider
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# PostgreSQL connection settings
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=require
DATABASE_URL=

# Server port (optional)
# PORT=3000
