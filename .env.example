# Copy this file to .env and fill values for production SMTP
# Example SMTP settings for real SMTP provider
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# Database settings (optional if using defaults)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=imtse_portal

# Server port (optional)
# PORT=3000
